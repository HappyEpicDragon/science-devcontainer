{
  "name": "${templateOption:ProjectName}",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "HTTP_PROXY": "http://host.docker.internal:7890",
      "HTTPS_PROXY": "http://host.docker.internal:7890",
      "ALL_PROXY": "socks5://host.docker.internal:7890",
      "NO_PROXY": "localhost,127.0.0.1,::1"
    }
  },

  "workspaceFolder": "/workspace",

  "mounts": [
    // workfolder
    "source=${localWorkspaceFolder},target=/workspace,type=bind",

    // codex auth and sessions
    "source=codex-config-${templateOption:ProjectName},target=/root/.codex,type=volume",

    // claude code auth and sessions
    "source=claude-config-${templateOption:ProjectName},target=/root/.claude,type=volume",

    // Docker Engine socket from the host
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",

    // K3s kubeconfig copied from the Windows host
    "source=${localEnv:USERPROFILE}/.kube,target=/root/.kube,type=bind"
  ],

  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--gpus",
    "all"
  ],


"remoteEnv": {
  "https_proxy": "http://host.docker.internal:7890",
  "http_proxy": "http://host.docker.internal:7890",
  "HTTPS_PROXY": "http://host.docker.internal:7890",
  "HTTP_PROXY": "http://host.docker.internal:7890",
  "NO_PROXY": "localhost,127.0.0.1,::1,10.15.89.0/24",
  "no_proxy": "localhost,127.0.0.1,::1,10.15.89.0/24"
},

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "renan-r-santos.pixi-code",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "tobiastimm.matter",
        "pkief.material-icon-theme",
        "tomoki1207.pdf",
        "james-yu.latex-workshop"
      ],
      "settings": {
        "http.proxy": "http://host.docker.internal:7890",
        "http.proxyStrictSSL": false,
        "python.defaultInterpreterPath": "/workspace/.pixi/envs/default/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  },

  "forwardPorts": [8888]
}
