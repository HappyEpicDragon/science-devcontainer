{
  "name": "${templateOption:ProjectName}",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "HTTP_PROXY": "http://host.docker.internal:7890",
      "HTTPS_PROXY": "http://host.docker.internal:7890",
      "ALL_PROXY": "socks5://host.docker.internal:7890",
      "NO_PROXY": "localhost,127.0.0.1,::1"
    }
  },

  "workspaceFolder": "/workspace",

  "mounts": [
    // workfolder
    "source=${localWorkspaceFolder},target=/workspace,type=bind",

    // codex auth and sessions
    "source=codex-config-${templateOption:ProjectName},target=/root/.codex,type=volume",

    // claude code auth and sessions
    "source=claude-config-${templateOption:ProjectName},target=/root/.claude,type=volume"
  ],

  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--gpus",
    "all"
  ],


"remoteEnv": {
  "https_proxy": "http://host.docker.internal:7890",
  "http_proxy": "http://host.docker.internal:7890",
  "HTTPS_PROXY": "http://host.docker.internal:7890",
  "HTTP_PROXY": "http://host.docker.internal:7890",
  "NO_PROXY": "localhost,127.0.0.1"
},

  "postCreateCommand": [
    "bash",
    "-lc",
    "set -euxo pipefail; \
    npm config set proxy \"$HTTP_PROXY\"; \
    npm config set https-proxy \"$HTTPS_PROXY\"; \
    npm config set fetch-timeout 60000; \
    npm config set fetch-retries 2; \
    npm install -g @openai/codex @anthropic-ai/claude-code --foreground-scripts --loglevel verbose; \
    npx --yes skills add HappyEpicDragon/research_memory --skill '*' -y; \
    npx --yes skills add HappyEpicDragon/paper-deconstruct -y"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "renan-r-santos.pixi-code",
        "ms-python.vscode-pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "tobiastimm.matter",
        "pkief.material-icon-theme",
        "tomoki1207.pdf"
      ],
      "settings": {
        "http.proxy": "http://host.docker.internal:7890",
        "http.proxyStrictSSL": false,
        "python.defaultInterpreterPath": "/workspace/.pixi/envs/default/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  },

  "forwardPorts": [8888]
}
